rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /activity_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read: if true;
      // Only these admin accounts can add/edit/delete content (keep in sync with ADMIN_EMAILS in App.tsx)
      allow write: if request.auth != null && request.auth.token.email in ['admin@thehireground.com', 'taibalo@bu.edu'];
    }
  }
}