rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /activity_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@thehireground.com';
    }
  }
}